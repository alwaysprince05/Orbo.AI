# Orbo Beauty AI — environment configuration
# Copy to .env and adjust as needed. All values shown are the defaults.

# ── FastAPI backend ────────────────────────────────────────────────────────────
# Path to the processed product catalogue (relative to repo root)
PRODUCTS_PATH=data/processed/products_processed.parquet

# Path to the fitted TF-IDF content model
MODEL_PATH=data/processed/content_model.joblib

# ── React frontend (website/) ─────────────────────────────────────────────────
# Base URL of the FastAPI backend the React app should call.
# In development the Vite proxy rewrites /api/* → http://localhost:8000/api/*
# so this variable is only needed for production builds.
# Example: https://orbo-api-xxxx.onrender.com
VITE_API_BASE_URL=http://localhost:8000
